{
  "buildCommand": "pnpm nx build wind-web",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "devCommand": "pnpm nx serve wind-web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://wind-intelligence-taupe.vercel.app/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
