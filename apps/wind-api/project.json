{
  "name": "wind-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/wind-api",
  "projectType": "application",
  "targets": {
    "serve": {
      "command": "uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
      "options": {
        "cwd": "apps/wind-api"
      }
    },
    "build": {
      "command": "echo \"No build step for Python\"",
      "options": {
        "cwd": "apps/wind-api"
      }
    },
    "test": {
      "command": "PYTHONPATH=apps/wind-api pytest",
      "options": {
        "cwd": "."
      }
    },
    "lint": {
      "command": "ruff check .",
      "options": {
        "cwd": "apps/wind-api"
      }
    }
  }
}