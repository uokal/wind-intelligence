{
  "buildCommand": "pnpm nx build wind-web",
  "outputDirectory": "apps/wind-web/dist",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "devCommand": "pnpm nx serve wind-web",
  "env": {
    "VITE_API_BASE_URL": ""
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
