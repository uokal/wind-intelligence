{
  "buildCommand": "pnpm nx build wind-web",
  "outputDirectory": "apps/wind-web/dist",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "devCommand": "pnpm nx serve wind-web",
  "env": {
    "VITE_API_BASE_URL": ""
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://wind-intelligence-taupe.vercel.app/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
